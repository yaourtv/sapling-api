# Required
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker?sslmode=disable
# Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=replace-with-random-32-byte-hex
REFRESH_TOKEN_SECRET=replace-with-random-32-byte-hex
CORS_ORIGIN=http://localhost:5173

# Optional
PORT=8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Optional SMTP — if SMTP_HOST is unset, password reset links are logged to stdout
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Used to build reset links, e.g. https://jobs.example.com
APP_BASE_URL=
